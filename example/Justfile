set shell := ["bash", "-cu"]

python3 := require("python3")
camus := require("camus")
project_name := `basename "$PWD"`

default:
    @{{ camus }} --check

open:
    @{{ camus }} --open

workshop:
    @open "workshop://project/open?name={{ project_name }}"

create name="":
    @{{ camus }} --create "{{ name }}.md"

build size="A4":
    @CAMUS_PDF_OPTIONS_PAGE_SIZE={{ size }} {{ camus }} --build

serve port="8080":
    @{{ python3 }} -m http.server --bind 127.0.0.1 {{ port }} --directory dist/html
